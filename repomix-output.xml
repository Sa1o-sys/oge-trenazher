}
.stage-select-body { flex: 1; min-width: 0; }
.stage-select-name {
  font-family: var(--font-display);
  font-size: 1.05rem;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 2px;
}
.stage-select-desc {
  font-size: 0.78rem;
  color: var(--text-muted);
  font-weight: 300;
}
.stage-select-lock {
  font-size: 0.75rem;
  color: var(--rose);
