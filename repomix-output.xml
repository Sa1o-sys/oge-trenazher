};

window._appLogout = () => logout(onAuthed);
window._syncBeforeLogout = async () => { clearTimeout(state._syncTimer); await syncAllProgressToFirebase(); };

// ─── WELCOME OVERLAYS ──────────────────────────────────────────────────────────
function showWelcome(profile) {
