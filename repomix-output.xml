.teacher-oge-line-wrap {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 16px;
}
.teacher-oge-line-title {
  text-align: center;
  font-size: 0.95rem;
  font-weight: 600;
  color: #5f5f5f;
  margin-bottom: 10px;
}
.teacher-oge-svg-scroll {
  overflow-x: auto;
  overflow-y: hidden;
}
.teacher-oge-line-svg {
  display: block;
  min-width: 100%;
}
.teacher-oge-grid-line {
  stroke: #d8d8d8;
  stroke-width: 1;
}
.teacher-oge-axis-line {
  stroke: #bbbbbb;
  stroke-width: 1.2;
}
.teacher-oge-line-path {
  fill: none;
  stroke: #0f6c96;
  stroke-width: 3;
  stroke-linecap: round;
  stroke-linejoin: round;
}
.teacher-oge-point {
  fill: #0f6c96;
  stroke: #fff;
  stroke-width: 2;
}
.teacher-oge-point.last {
  fill: #2e8b3c;
}
.teacher-oge-axis-text {
  fill: #666;
  font-size: 12px;
  font-family: var(--font-body);
}
.teacher-oge-value-text {
  fill: #0f6c96;
  font-size: 12px;
  font-weight: 700;
  font-family: var(--font-body);
}

.empty-state { text-align: center; padding: 40px 20px; color: var(--text-muted); background: var(--surface); border: 1px dashed var(--border2); border-radius: var(--radius); }
.spinner { width: 32px; height: 32px; border: 2.5px solid var(--border2); border-top-color: var(--accent); border-radius: 50%; animation: spin 0.8s linear infinite; }

.hidden { display: none !important; }
.tag { display: inline-block; font-size: 0.7rem; font-weight: 500; padding: 3px 10px; border-radius: 50px; background: var(--bg2); color: var(--text-muted); border: 1px solid var(--border); letter-spacing: 0.03em; }
.section-title { font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.12em; color: var(--text-muted); margin-bottom: 12px; }
.spacer { flex: 1; }
.mt-8 { margin-top: 8px; } .mt-16 { margin-top: 16px; } .mb-16 { margin-bottom: 16px; }
.text-muted { color: var(--text-muted); } .text-center { text-align: center; }
.flex { display: flex; } .gap-10 { gap: 10px; } .flex-wrap { flex-wrap: wrap; }

@keyframes fadeSlideIn { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:translateY(0); } }
@keyframes fadeIn      { from { opacity:0; } to { opacity:1; } }
@keyframes scaleIn     { from { opacity:0; transform:scale(0.96); } to { opacity:1; transform:scale(1); } }
@keyframes pulse       { 0%,100% { opacity:1; } 50% { opacity:0.55; } }
@keyframes spin        { to { transform:rotate(360deg); } }
.screen-enter { animation: fadeSlideIn 0.3s ease; }

@media (max-width: 600px) {
  #app { padding: 18px 14px; }
  .categories-grid { grid-template-columns: 1fr; }
  .answer-input-wrap { flex-direction: column; }
  .results-table th:nth-child(2), .results-table td:nth-child(2) { display: none; }
  .auth-screen { justify-content: flex-start; padding-top: 36px; }
  .auth-card { padding: 20px 16px; }
  .role-btn { padding: 16px 10px; }
  .form-input { font-size: 16px; }
  .mini-oge-header { flex-direction: column; align-items: flex-start; }
  .stage-bar { flex-wrap: wrap; }
  .dashboard-header { margin-bottom: 28px; }
  .profile-header { align-items: flex-start; }
  .profile-kpi-grid { grid-template-columns: 1fr; }
  .profile-insight-row { grid-template-columns: 1fr; }
  .profile-stage-grid { grid-template-columns: 1fr; }
  .trap-row { align-items: flex-start; flex-direction: column; }
  .mini-oge-summary-row { grid-template-columns: 1fr; }
  .teacher-topbar { flex-direction: column; }
  .teacher-metrics-grid { grid-template-columns: 1fr; }
  .teacher-activity-row { flex-wrap: wrap; }
  .teacher-activity-date { width: 100%; text-align: left; }
  .teacher-mini-class-row { grid-template-columns: 1fr 1fr; }
  .teacher-mini-class-bar { grid-column: 1 / -1; }
  .teacher-mini-class-meta { grid-column: 1 / -1; text-align: left; }
}

/* =============================================
   WELCOME MODAL
   ============================================= */
#welcome-overlay {
  position: fixed; inset: 0;
  background: rgba(58,50,40,0.45);
  display: flex; align-items: center; justify-content: center;
  z-index: 2000;
  backdrop-filter: blur(8px);
  animation: fadeIn 0.3s ease;
  padding: 20px;
}
.welcome-box {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 36px 28px;
  max-width: 400px; width: 100%;
  box-shadow: 0 12px 48px rgba(58,50,40,0.18);
  animation: scaleIn 0.3s cubic-bezier(.34,1.56,.64,1);
  text-align: center;
}
.welcome-emoji {
  font-size: 3rem;
  line-height: 1;
  margin-bottom: 16px;
}
.welcome-title {
  font-family: var(--font-display);
  font-size: 1.7rem;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 12px;
}
.welcome-text {
  font-size: 0.88rem;
  color: var(--text-muted);
  line-height: 1.7;
  margin-bottom: 22px;
}
.welcome-steps {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-bottom: 26px;
  text-align: left;
}
.welcome-step {
  display: flex;
  align-items: center;
  gap: 12px;
  background: var(--bg2);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 10px 14px;
  font-size: 0.85rem;
  color: var(--text);
}
.welcome-step-icon {
  font-size: 1.2rem;
  flex-shrink: 0;
}
.welcome-btn {
  width: 100%;
  padding: 13px;
  font-size: 0.95rem;
}

/* =============================================
   STAGE SELECT SCREEN
   ============================================= */
.stage-select-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.stage-select-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  padding: 16px 18px;
  background: var(--surface);
  border: 1.5px solid var(--border);
  border-radius: var(--radius);
  cursor: pointer;
  transition: all var(--transition);
  text-align: left;
  width: 100%;
  font-family: var(--font-body);
  box-shadow: var(--shadow-sm);
}
.stage-select-btn:hover:not(.locked) {
  border-color: var(--accent3);
  box-shadow: var(--shadow);
  transform: translateY(-1px);
}
.stage-select-btn.complete {
  border-color: var(--sage);
  background: #f9fdf8;
}
.stage-select-btn.started {
  border-color: var(--accent3);
}
.stage-select-btn.locked {
  opacity: 0.55;
  cursor: not-allowed;
  background: var(--bg2);
}
.stage-select-left {
  display: flex;
  align-items: center;
  gap: 14px;
  flex: 1;
  min-width: 0;
}
.stage-select-icon {
  font-size: 1.6rem;
  flex-shrink: 0;
  width: 36px;
  text-align: center;
}
.stage-select-name {
  font-family: var(--font-display);
  font-size: 1.05rem;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 2px;
}
.stage-select-desc {
  font-size: 0.78rem;
  color: var(--text-muted);
  font-weight: 300;
  line-height: 1.4;
}
.stage-select-right {
  flex-shrink: 0;
  text-align: right;
}

/* =============================================
   STAGE SELECT SCREEN
   ============================================= */
.stage-select-grid {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-top: 8px;
}
.stage-select-card {
  display: flex;
  align-items: center;
  gap: 16px;
  background: var(--surface);
  border: 1.5px solid var(--border);
  border-radius: var(--radius);
  padding: 16px 18px;
  cursor: pointer;
  transition: all var(--transition);
  text-align: left;
  width: 100%;
  font-family: var(--font-body);
