/* =============================================
   TOPIC DESCRIPTION + STAGE MINI LIST
   ============================================= */
.topic-desc-list {
  display: flex;
  flex-direction: column;
  gap: 7px;
}
.topic-desc-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 7px 0;
  border-bottom: 1px solid var(--border);
}
.topic-desc-item:last-child { border-bottom: none; }
.topic-desc-code {
  font-size: 0.7rem;
  font-weight: 600;
  color: var(--accent);
  background: var(--bg2);
  border: 1px solid var(--border2);
  border-radius: 6px;
  padding: 2px 7px;
  white-space: nowrap;
  font-family: monospace;
  flex-shrink: 0;
}
.topic-desc-name {
  font-size: 0.88rem;
  color: var(--text);
}
.stage-mini-list {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
  margin-top: 6px;
}
.stage-mini-item {
  display: flex;
  align-items: center;
  gap: 5px;
  background: var(--bg2);
  border: 1px solid var(--border);
  border-radius: 50px;
  padding: 3px 10px;
  font-size: 0.72rem;
  color: var(--text-muted);
}
.stage-mini-item.locked {
