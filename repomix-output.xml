}
.stage-select-done {
  font-size: 0.75rem;
  color: var(--sage);
  font-weight: 600;
  margin-top: 4px;
}
.stage-select-progress {
  font-size: 0.75rem;
  color: var(--accent);
  font-weight: 600;
  margin-top: 4px;
}
.stage-select-arrow {
