/* =============================================
   ТРЕНАЖЁР ОГЭ — Aesthetic Light Theme
   ============================================= */

@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Jost:wght@300;400;500;600&display=swap');

:root {
  --bg:        #f7f4f0;
  --bg2:       #f0ece6;
  --surface:   #ffffff;
  --surface2:  #faf8f5;
  --border:    #e8e2d9;
  --border2:   #d9d0c4;
  --accent:    #8b7355;
  --accent2:   #b5926a;
  --accent3:   #c9b99a;
  --sage:      #8fa68a;
  --rose:      #c4867a;
  --sky:       #7a9ab5;
  --lavender:  #9b91b8;
  --text:      #3a3228;
  --text-muted: #8a7d6e;
  --text-dim:   #c4b8a8;
  --success:   #8fa68a;
  --danger:    #c4867a;
  --warning:   #c9a05a;
  --radius:    20px;
  --radius-sm: 12px;
  --radius-xs: 8px;
  --shadow:    0 2px 20px rgba(139,115,85,0.10);
  --shadow-sm: 0 1px 8px rgba(139,115,85,0.07);
  --font-display: 'Cormorant Garamond', Georgia, serif;
  --font-body:    'Jost', system-ui, sans-serif;
  --transition:   0.2s cubic-bezier(.4,0,.2,1);
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-body);
  font-size: 15px;
  font-weight: 400;
  line-height: 1.65;
  -webkit-font-smoothing: antialiased;
}
body::before {
  content: '';
  position: fixed; inset: 0;
  background-image: radial-gradient(circle, var(--border) 1px, transparent 1px);
  background-size: 32px 32px;
  opacity: 0.35;
  pointer-events: none; z-index: 0;
}
#app {
  position: relative; z-index: 1;
  max-width: 860px; margin: 0 auto;
  padding: 24px 18px; min-height: 100vh;
}

h1 { font-family: var(--font-display); font-size: clamp(1.8rem,5vw,2.6rem); font-weight: 600; line-height: 1.15; color: var(--text); }
h2 { font-family: var(--font-display); font-size: clamp(1.3rem,3.5vw,1.9rem); font-weight: 600; line-height: 1.2; color: var(--text); }
h3 { font-family: var(--font-display); font-size: 1.15rem; font-weight: 600; color: var(--text); }
p  { color: var(--text-muted); }

.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 6px;
  padding: 11px 22px; border: 1.5px solid transparent; border-radius: 50px;
  font-family: var(--font-body); font-size: 0.88rem; font-weight: 500;
  letter-spacing: 0.02em; cursor: pointer; transition: all var(--transition);
  white-space: nowrap; text-decoration: none;
}
.btn:disabled { opacity: 0.4; cursor: not-allowed; pointer-events: none; }
.btn-primary  { background: var(--accent); color: #fff; border-color: var(--accent); }
.btn-primary:hover { background: var(--accent2); border-color: var(--accent2); transform: translateY(-1px); box-shadow: 0 4px 16px rgba(139,115,85,0.25); }
.btn-secondary { background: var(--surface); color: var(--text); border-color: var(--border2); }
.btn-secondary:hover { background: var(--bg2); border-color: var(--accent3); }
.btn-success { background: var(--sage); color: #fff; border-color: var(--sage); }
.btn-success:hover { filter: brightness(1.08); transform: translateY(-1px); }
.btn-danger  { background: transparent; color: var(--rose); border-color: var(--rose); }
.btn-danger:hover { background: var(--rose); color: #fff; }
.btn-ghost   { background: transparent; color: var(--text-muted); border-color: transparent; padding: 8px 14px; }
.btn-ghost:hover { color: var(--text); background: var(--bg2); }
.btn-warning { background: var(--warning); color: #fff; border-color: var(--warning); }
.btn-warning:hover { filter: brightness(1.08); transform: translateY(-1px); }
.btn-large   { padding: 14px 30px; font-size: 0.95rem; }

.card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 22px; transition: all var(--transition); box-shadow: var(--shadow-sm); }
.card:hover { box-shadow: var(--shadow); border-color: var(--border2); }

.stage-bar { display: flex; align-items: center; gap: 10px; margin-bottom: 28px; background: var(--surface); border: 1px solid var(--border); border-radius: 50px; padding: 10px 20px; box-shadow: var(--shadow-sm); }
.stage-bar-label { font-size: 0.8rem; color: var(--text-muted); font-weight: 500; white-space: nowrap; letter-spacing: 0.03em; }
.stage-dots { display: flex; gap: 6px; }
.stage-dot  { width: 8px; height: 8px; border-radius: 50%; background: var(--border2); transition: background var(--transition); }
.stage-dot.active { background: var(--accent); }
.stage-dot.done   { background: var(--sage); }

.circle-progress { position: relative; width: 52px; height: 52px; flex-shrink: 0; }
.circle-progress svg { transform: rotate(-90deg); }
.circle-progress .track { fill: none; stroke: var(--bg2); stroke-width: 3.5; }
.circle-progress .fill  { fill: none; stroke: var(--accent); stroke-width: 3.5; stroke-linecap: round; transition: stroke-dashoffset 0.7s cubic-bezier(.4,0,.2,1); }
.circle-progress .fill.complete { stroke: var(--sage); }
.circle-pct { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 0.68rem; font-weight: 600; color: var(--text); }

.dashboard-header { text-align: center; margin-bottom: 40px; padding-top: 16px; }
.dashboard-header h1 { color: var(--text); margin-bottom: 6px; }
.dashboard-header p { color: var(--text-muted); font-size: 0.9rem; font-weight: 300; letter-spacing: 0.05em; }
.dashboard-divider { width: 48px; height: 2px; background: var(--accent3); margin: 14px auto; border-radius: 2px; }

.categories-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 12px; margin-bottom: 28px; }

.category-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 18px; display: flex; flex-direction: column; gap: 12px; cursor: pointer; transition: all var(--transition); position: relative; overflow: hidden; box-shadow: var(--shadow-sm); }
.category-card::after { content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 2px; background: linear-gradient(90deg, var(--accent3), var(--lavender)); opacity: 0; transition: opacity var(--transition); }
.category-card:hover::after { opacity: 1; }
.category-card:hover { transform: translateY(-2px); box-shadow: var(--shadow); border-color: var(--border2); }
.category-card.complete { border-color: var(--sage); }
.category-card.complete::after { background: var(--sage); opacity: 1; }
.category-card-top { display: flex; align-items: flex-start; justify-content: space-between; }
.category-icon { font-size: 1.5rem; line-height: 1; }
.category-name { font-family: var(--font-display); font-size: 1.15rem; font-weight: 600; color: var(--text); line-height: 1.3; }
.category-progress-text { font-size: 0.85rem; color: var(--text-muted); font-weight: 400; margin-top: 4px; }
.dashboard-actions { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; }

.screen-header { display: flex; align-items: center; gap: 12px; margin-bottom: 28px; }
.screen-header h2 { flex: 1; }

.subtopic-list { display: flex; flex-direction: column; gap: 8px; margin-bottom: 24px; }
.subtopic-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 16px 18px; display: flex; align-items: center; gap: 14px; transition: all var(--transition); box-shadow: var(--shadow-sm); }
.subtopic-card:hover { border-color: var(--border2); box-shadow: var(--shadow); }
.subtopic-info { flex: 1; }
.subtopic-name { font-weight: 500; color: var(--text); font-size: 0.93rem; }
.subtopic-status { font-size: 0.75rem; margin-top: 2px; }
.subtopic-status.not-started { color: var(--text-dim); }
.subtopic-status.in-progress  { color: var(--warning); }
.subtopic-status.done         { color: var(--sage); }
.trap-card { background: #fff8f5; border-color: #e8c8be; }
.trap-card .subtopic-name { color: var(--rose); }

.stage-screen { max-width: 660px; margin: 0 auto; }
.examples-block { background: var(--bg2); border-left: 3px solid var(--accent3); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; padding: 18px 20px; margin-bottom: 20px; display: flex; flex-direction: column; gap: 10px; }
.example-sentence { font-family: var(--font-display); font-size: 1.05rem; color: var(--text); font-style: italic; }
.highlight { color: var(--accent); font-weight: 600; font-style: normal; background: rgba(139,115,85,0.08); padding: 1px 5px; border-radius: 4px; }
.reflection-question { font-weight: 500; color: var(--text); margin-bottom: 10px; font-size: 0.93rem; }
.reflection-textarea { width: 100%; background: var(--surface); border: 1.5px solid var(--border); border-radius: var(--radius-sm); color: var(--text); font-family: var(--font-body); font-size: 0.9rem; padding: 12px 14px; resize: vertical; min-height: 80px; margin-bottom: 14px; transition: border-color var(--transition); }
.reflection-textarea:focus { outline: none; border-color: var(--accent3); }
.reflection-textarea::placeholder { color: var(--text-dim); }
.explanation-block { background: #f5faf4; border: 1px solid #c8ddc4; border-radius: var(--radius); padding: 16px 18px; margin: 16px 0; color: var(--text); line-height: 1.7; font-size: 0.92rem; animation: fadeSlideIn 0.3s ease; }
.explanation-block.hidden { display: none; }

.rule-card { background: #f8f5ff; border: 1px solid #ddd5f0; border-radius: var(--radius); padding: 18px 20px; margin-bottom: 20px; }
.rule-card h3 { color: var(--lavender); margin-bottom: 8px; font-size: 0.88rem; letter-spacing: 0.04em; }
.rule-card p { color: var(--text); font-size: 0.92rem; line-height: 1.7; }
.rule-card .rule-example { margin-top: 12px; font-family: var(--font-display); font-style: italic; color: var(--text-muted); font-size: 0.95rem; border-top: 1px solid #ddd5f0; padding-top: 10px; }

.question-block { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 16px 18px; margin-bottom: 10px; box-shadow: var(--shadow-sm); }
.question-text { font-weight: 500; margin-bottom: 12px; font-size: 0.92rem; }
.options-list { display: flex; flex-direction: column; gap: 7px; }
.option-label { display: flex; align-items: center; gap: 10px; padding: 10px 14px; border: 1.5px solid var(--border); border-radius: 50px; cursor: pointer; transition: all var(--transition); font-size: 0.88rem; color: var(--text); }
.option-label:hover { border-color: var(--accent3); background: var(--bg2); }
.option-label input { accent-color: var(--accent); }
.option-label.correct { border-color: var(--sage); background: #f4faf3; color: var(--sage); }
.option-label.wrong   { border-color: var(--rose); background: #fdf5f4; color: var(--rose); }
.error-explanation { background: #fdf5f4; border: 1px solid #e8c4be; border-radius: var(--radius-xs); padding: 9px 13px; font-size: 0.83rem; color: var(--text); margin-top: 8px; }

.task-counter { text-align: right; font-size: 0.78rem; color: var(--text-muted); margin-bottom: 12px; letter-spacing: 0.05em; }
.task-context { font-family: var(--font-display); font-size: 1.1rem; color: var(--text); background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 18px 22px; margin-bottom: 16px; line-height: 1.8; font-style: italic; box-shadow: var(--shadow-sm); }
.answer-input-wrap { display: flex; gap: 8px; margin-bottom: 14px; }
.answer-input { flex: 1; background: var(--surface); border: 1.5px solid var(--border); border-radius: 50px; color: var(--text); font-family: var(--font-body); font-size: 0.95rem; padding: 11px 18px; transition: border-color var(--transition); }
.answer-input:focus { outline: none; border-color: var(--accent3); }
.answer-input::placeholder { color: var(--text-dim); }
.answer-input.correct { border-color: var(--sage); background: #f4faf3; }
.answer-input.wrong   { border-color: var(--rose); background: #fdf5f4; }

.feedback-block { border-radius: var(--radius); padding: 14px 18px; margin-bottom: 14px; font-size: 0.9rem; line-height: 1.6; animation: fadeSlideIn 0.25s ease; }
.feedback-block.correct { background: #f4faf3; border: 1px solid #c8ddc4; color: var(--sage); }
.feedback-block.wrong   { background: #fdf5f4; border: 1px solid #e8c4be; color: var(--text); }
.feedback-block .correct-answer { font-weight: 600; color: var(--sage); }
.feedback-block .cognitive-hint { color: var(--text-muted); margin-top: 6px; font-size: 0.83rem; }
.practice-actions { display: flex; gap: 8px; flex-wrap: wrap; }

.summary-result { text-align: center; padding: 28px 0; margin-bottom: 24px; }
.summary-big-score { font-family: var(--font-display); font-size: clamp(3rem,10vw,5rem); font-weight: 600; color: var(--accent); line-height: 1; margin-bottom: 6px; }
.summary-label { color: var(--text-muted); font-size: 0.88rem; font-weight: 300; letter-spacing: 0.04em; }
.mistakes-list { display: flex; flex-direction: column; gap: 7px; margin-bottom: 20px; }
.mistake-item { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 10px 14px; font-size: 0.84rem; color: var(--text-muted); }
.mistake-item strong { color: var(--text); }
.summary-actions { display: flex; gap: 8px; flex-wrap: wrap; }

.mini-oge-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; flex-wrap: wrap; gap: 12px; }
.timer-block { display: flex; align-items: center; gap: 8px; background: var(--surface); border: 1px solid var(--border); border-radius: 50px; padding: 8px 16px; font-size: 0.92rem; font-weight: 500; color: var(--text-muted); box-shadow: var(--shadow-sm); }
.timer-block.urgent { color: var(--rose); border-color: var(--rose); animation: pulse 1s infinite; }
.mini-progress-bar { height: 4px; background: var(--bg2); border-radius: 50px; overflow: hidden; margin-bottom: 22px; }
.mini-progress-fill { height: 100%; background: linear-gradient(90deg, var(--accent3), var(--accent)); border-radius: 50px; transition: width 0.4s ease; }

.results-table { width: 100%; border-collapse: collapse; margin-bottom: 20px; font-size: 0.86rem; }
.results-table th { text-align: left; padding: 8px 12px; color: var(--text-muted); font-weight: 500; border-bottom: 1px solid var(--border); font-size: 0.78rem; letter-spacing: 0.04em; }
.results-table td { padding: 10px 12px; border-bottom: 1px solid var(--border); vertical-align: top; }
.results-table tr:last-child td { border-bottom: none; }
.result-correct { color: var(--sage); font-weight: 600; }
.result-wrong   { color: var(--rose); font-weight: 600; }
.result-link    { color: var(--accent); font-size: 0.78rem; cursor: pointer; text-decoration: underline; }

.modal-overlay { position: fixed; inset: 0; background: rgba(58,50,40,0.35); display: flex; align-items: center; justify-content: center; z-index: 1000; backdrop-filter: blur(6px); animation: fadeIn 0.15s ease; }
.modal-overlay.hidden { display: none; }
.modal-box { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 28px; max-width: 360px; width: 90%; box-shadow: 0 8px 40px rgba(58,50,40,0.15); animation: scaleIn 0.2s ease; }
.modal-text { margin-bottom: 22px; line-height: 1.6; color: var(--text); font-size: 0.93rem; }
.modal-actions { display: flex; gap: 8px; justify-content: flex-end; }

.auth-screen { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 100vh; padding: 24px 16px; }
.auth-logo { text-align: center; margin-bottom: 32px; }
.auth-logo-icon { font-size: 2.8rem; margin-bottom: 10px; line-height: 1; }
.auth-logo h1 { color: var(--text); margin-bottom: 4px; }
.auth-logo p { color: var(--text-muted); font-size: 0.88rem; font-weight: 300; letter-spacing: 0.04em; }
.auth-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 28px 24px; width: 100%; max-width: 400px; box-shadow: var(--shadow); }

.role-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.role-btn { display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 20px 12px; background: var(--bg2); border: 1.5px solid var(--border); border-radius: var(--radius); cursor: pointer; transition: all var(--transition); color: var(--text); font-family: var(--font-body); }
.role-btn:hover { border-color: var(--accent3); background: var(--surface); transform: translateY(-2px); box-shadow: var(--shadow); }
.role-icon  { font-size: 1.8rem; line-height: 1; }
.role-label { font-family: var(--font-display); font-size: 1rem; font-weight: 600; }
.role-desc  { font-size: 0.72rem; color: var(--text-muted); text-align: center; line-height: 1.4; font-weight: 300; }

.auth-tabs { display: flex; margin-bottom: 22px; background: var(--bg2); border-radius: 50px; padding: 3px; }
.auth-tab { flex: 1; padding: 9px; border: none; border-radius: 50px; background: transparent; color: var(--text-muted); font-family: var(--font-body); font-size: 0.86rem; font-weight: 500; cursor: pointer; transition: all var(--transition); }
.auth-tab.active { background: var(--surface); color: var(--text); box-shadow: 0 1px 6px rgba(139,115,85,0.12); }

.form-group { margin-bottom: 14px; }
.form-label { display: block; font-size: 0.78rem; font-weight: 500; color: var(--text-muted); margin-bottom: 6px; letter-spacing: 0.04em; }
.form-input { width: 100%; background: var(--bg2); border: 1.5px solid var(--border); border-radius: 50px; color: var(--text); font-family: var(--font-body); font-size: 0.95rem; padding: 11px 16px; transition: border-color var(--transition); }
.form-input:focus { outline: none; border-color: var(--accent3); background: var(--surface); }
.form-input::placeholder { color: var(--text-dim); }
.form-error   { background: #fdf5f4; border: 1px solid #e8c4be; border-radius: var(--radius-sm); padding: 9px 13px; font-size: 0.83rem; color: var(--rose); }
.form-success { background: #f4faf3; border: 1px solid #c8ddc4; border-radius: var(--radius-sm); padding: 9px 13px; font-size: 0.83rem; color: var(--sage); }

.app-layout { display: flex; flex-direction: column; min-height: 100vh; }
.app-content { flex: 1; padding-bottom: 80px; }
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
