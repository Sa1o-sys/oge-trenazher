/* Dashboard greeting */
.dashboard-subtitle {
  color: var(--text-muted);
  font-size: 0.82rem;
  font-weight: 300;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin-bottom: 6px;
}
.dashboard-greeting {
  color: var(--text-muted);
  font-size: 0.92rem;
  font-weight: 400;
  line-height: 1.6;
  max-width: 420px;
  margin: 10px auto 0;
}

/* =============================================
   МИНИ-ОГЭ — стиль настоящего экзамена
   ============================================= */
.oge-wrapper {
  max-width: 720px;
  margin: 0 auto;
  padding-bottom: 40px;
}
.oge-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 16px;
  padding: 16px 20px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
}
.oge-title {
  font-family: var(--font-display);
  font-size: 1.15rem;
  font-weight: 600;
  color: var(--text);
}
.oge-subtitle {
  font-size: 0.8rem;
  color: var(--text-muted);
  margin-top: 3px;
}
.oge-timer {
  font-size: 1rem;
  font-weight: 600;
  color: var(--text-muted);
  background: var(--bg2);
  border: 1px solid var(--border);
  border-radius: 50px;
  padding: 6px 14px;
  white-space: nowrap;
  flex-shrink: 0;
}
.oge-timer.urgent {
  color: var(--rose);
  border-color: var(--rose);
  animation: pulse 1s infinite;
}
.oge-instruction {
  background: #fffdf5;
  border: 1px solid #e8dfc8;
  border-left: 4px solid var(--accent);
  border-radius: var(--radius-sm);
  padding: 12px 16px;
  font-size: 0.85rem;
  color: var(--text);
  font-style: italic;
  line-height: 1.6;
  margin-bottom: 20px;
}
.oge-tasks {
  display: flex;
  flex-direction: column;
  gap: 0;
  border: 1.5px solid var(--border2);
  border-radius: var(--radius);
  overflow: hidden;
  background: var(--surface);
  box-shadow: var(--shadow-sm);
  margin-bottom: 24px;
}
.oge-task-row {
  display: flex;
  align-items: flex-start;
  gap: 0;
  border-bottom: 1px solid var(--border);
  transition: background var(--transition);
}
.oge-task-row:last-child { border-bottom: none; }
.oge-task-row:hover { background: var(--bg2); }

.oge-task-num {
  width: 52px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-display);
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--surface);
  background: var(--accent);
  min-height: 64px;
  padding: 12px 0;
  align-self: stretch;
}
.oge-task-body {
  flex: 1;
  padding: 12px 16px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.oge-sentence {
  font-size: 0.92rem;
  color: var(--text);
  line-height: 1.7;
}
.oge-input {
  display: inline-block;
  width: 160px;
  background: var(--bg2);
  border: none;
  border-bottom: 2px solid var(--accent3);
  border-radius: 0;
  color: var(--text);
  font-family: var(--font-body);
  font-size: 0.92rem;
  padding: 2px 8px;
  margin: 0 4px;
  transition: border-color var(--transition);
  vertical-align: baseline;
}
.oge-input:focus {
  outline: none;
  border-bottom-color: var(--accent);
  background: var(--surface);
}
.oge-input.correct {
  border-bottom-color: var(--sage);
  background: #f4faf3;
  color: var(--sage);
}
.oge-input.wrong {
  border-bottom-color: var(--rose);
  background: #fdf5f4;
  color: var(--rose);
}
.oge-word-hint {
  font-size: 0.75rem;
  color: var(--text-muted);
  letter-spacing: 0.03em;
}
.oge-result-ok {
  font-size: 0.82rem;
  color: var(--sage);
  font-weight: 600;
}
.oge-result-err {
  font-size: 0.82rem;
  color: var(--rose);
  font-weight: 500;
}
.oge-result-err em {
  font-style: normal;
  font-weight: 700;
  color: var(--sage);
}
.oge-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
}
.oge-score {
  text-align: center;
  padding: 20px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  width: 100%;
  box-shadow: var(--shadow-sm);
  margin-bottom: 8px;
}
.oge-score-num {
  font-family: var(--font-display);
  font-size: 3.5rem;
  font-weight: 600;
  color: var(--accent);
  line-height: 1;
  margin-bottom: 4px;
}
.oge-score-label {
  font-size: 0.88rem;
  color: var(--text-muted);
  margin-bottom: 8px;
}
.oge-score-grade {
  font-size: 1.1rem;
  font-weight: 600;
  color: var(--text);
}
@media (max-width: 600px) {
  .oge-task-num { width: 38px; font-size: 0.95rem; }
  .oge-input { width: 120px; }
}

/* ─── EXERCISE OPTION LETTER ─────────────────── */
.option-letter {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background: var(--bg2);
  border: 1px solid var(--border2);
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--text-muted);
  flex-shrink: 0;
  margin-right: 4px;
  transition: all var(--transition);
}
.option-label:hover .option-letter {
  background: var(--accent3);
  color: var(--surface);
  border-color: var(--accent3);
}
.option-label.correct .option-letter {
  background: var(--sage);
  color: white;
  border-color: var(--sage);
}
.option-label.wrong .option-letter {
  background: var(--rose);
  color: white;
  border-color: var(--rose);
}

/* ─── TASK INSTRUCTION ───────────────────────── */
.task-instruction {
  font-size: 0.78rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--text-muted);
  margin-bottom: 10px;
}

/* ═══════════════════════════════════════════════
   БЛОК «РАЗБОР ОШИБОК — ПЛАН НА УРОК»
   ═══════════════════════════════════════════════ */

/* Баннер-сводка */
.lesson-plan-banner {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  background: var(--surface2);
  border: 1.5px solid var(--border2);
  border-radius: var(--radius);
  padding: 16px 18px;
  margin-bottom: 18px;
}
.lesson-plan-banner-icon {
  font-size: 1.8rem;
  line-height: 1;
  flex-shrink: 0;
  margin-top: 2px;
}
.lesson-plan-banner-title {
  font-family: var(--font-display);
  font-size: 1.1rem;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 8px;
}
.lesson-plan-banner-desc {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.lp-chip {
  display: inline-flex;
  align-items: center;
  padding: 5px 12px;
  border-radius: 50px;
  font-size: 0.82rem;
  font-weight: 600;
  letter-spacing: 0.01em;
}
.lp-chip-red   { background: rgba(196,134,122,0.14); color: #8b2c2c; border: 1px solid rgba(196,134,122,0.35); }
.lp-chip-amber { background: rgba(201,160,90,0.14); color: #7a4e10; border: 1px solid rgba(201,160,90,0.35); }
.lp-chip-green { background: rgba(143,166,138,0.14); color: #2e5e2a; border: 1px solid rgba(143,166,138,0.35); }

/* Список карточек тем */
.lesson-topics-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

/* Карточка одной темы */
.lesson-topic-card {
  background: var(--surface);
  border: 1.5px solid var(--border);
  border-radius: var(--radius);
  padding: 16px 18px;
  transition: box-shadow var(--transition), border-color var(--transition);
  box-shadow: var(--shadow-sm);
}
.lesson-topic-card:hover {
  box-shadow: var(--shadow);
}
.lesson-topic-card.priority-critical { border-left: 4px solid var(--rose); }
.lesson-topic-card.priority-warn     { border-left: 4px solid var(--warning); }
.lesson-topic-card.priority-ok       { border-left: 4px solid var(--sage); }

/* Заголовок карточки */
.lesson-topic-header {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 12px;
}
.lesson-topic-num {
  font-family: var(--font-display);
  font-size: 1.6rem;
  font-weight: 600;
  color: var(--border2);
  line-height: 1;
  flex-shrink: 0;
  width: 24px;
}
.lesson-topic-name {
  flex: 1;
  font-size: 0.97rem;
  font-weight: 600;
  color: var(--text);
  line-height: 1.3;
}
.lesson-priority-badge {
  flex-shrink: 0;
  font-size: 0.75rem;
  font-weight: 700;
  padding: 4px 10px;
  border-radius: 50px;
  white-space: nowrap;
